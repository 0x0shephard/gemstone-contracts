# Production deployment template for Arbitrum One (other L2s need their own feed,
# uptime-feed and token addresses). Copy to a private env file and
# fill every empty value. Feed and token addresses below were checked on-chain
# against chain 42161; re-check them on data.chain.link before deploying.
PRIVATE_KEY=
GIFT_OPERATOR_ADDRESS=
RPC_URL=https://your-arbitrum-rpc.example
EXPECTED_CHAIN_ID=42161
PRODUCTION_DEPLOYMENT=true

# Chainlink ETH / USD on Arbitrum One (8 decimals).
ETH_USD_FEED=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612
ETH_USD_MIN_ANSWER=50000000000
ETH_USD_MAX_ANSWER=1000000000000
# Seconds before a price counts as stale. Arbitrum's ETH/USD and USDC/USD feeds
# may go a full day (86400s heartbeat) between updates, so allow 25 hours. A
# one-hour window would reject valid prices for most of each day.
PRICE_STALE_AFTER=90000
ETH_USD_STALE_AFTER=90000

# Native USDC on Arbitrum One (6 decimals), not bridged USDC.e, priced by
# Chainlink USDC / USD (8 decimals). Comma-separate to add more tokens.
PAYMENT_TOKENS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
PAYMENT_TOKEN_USD_FEEDS=0x50834F3163758fcC1Df9973b6e91f0F0F0434aD3
PAYMENT_TOKEN_MIN_ANSWERS=80000000
PAYMENT_TOKEN_MAX_ANSWERS=120000000
PAYMENT_TOKEN_STALE_AFTERS=90000

# Chainlink L2 sequencer uptime feed on Arbitrum One. Required for a production
# Arbitrum deployment: prices are refused while the sequencer is down and for the
# grace period after it comes back.
SEQUENCER_UPTIME_FEED=0xFdB631F5EE196F0ed6FAa767959853A9F217697D
SEQUENCER_GRACE_PERIOD=3600

# Under $1,000: 15%. $1,000 and above: 10%.
# Reserve-free launch: set DEFAULT_RESERVE_BPS=0 and RESERVE_BRACKET_BPS=0,0, then
# activate later with script/ConfigureReservePolicy.s.sol (gemstone-frontend docs/reserve-free-launch.md).
DEFAULT_RESERVE_BPS=1000
RESERVE_BRACKET_MAX_USD=1000000000000000000000,115792089237316195423570985008687907853269984665640564039457584007913129639935
RESERVE_BRACKET_BPS=1500,1000
SECONDARY_FEE_BPS=200

# Redemption signers. The proof approver and the authorizer must be different
# addresses. Recovery needs at least REDEMPTION_RECOVERY_THRESHOLD approvers
# (default 2), comma-separated, distinct from each other and from the authorizer.
REDEMPTION_PROOF_APPROVER=
REDEMPTION_AUTHORIZER=
REDEMPTION_RECOVERY_APPROVERS=
REDEMPTION_RECOVERY_THRESHOLD=2
REDEMPTION_RECOVERY_DELAY=604800

# Use production multisigs or governed modules. Do not leave these as the
# deployer EOA on a live-value network.
PLATFORM_RECIPIENT=
VAULT_RESERVE_RECIPIENT=
INSURANCE_RESERVE_RECIPIENT=
TREASURY_RESERVE_RECIPIENT=

# Outside marketplaces (OpenSea and others). All optional.
# COLLECTION_OWNER: the account OpenSea lets claim and edit the collection page and
# its payout settings. Use a Safe, not the deployer. Grants no on-chain permission.
COLLECTION_OWNER=
# ERC-7572 collection metadata served by the app.
CONTRACT_URI=https://digitalcarat.io/collection.json
# ERC-2981 royalty, at most 1000 (10%). Marketplaces may treat royalties as optional.
ROYALTY_RECEIVER=
ROYALTY_BPS=0

# Contract verification on Arbiscan (foundry.toml [etherscan]).
ARBISCAN_API_KEY=
