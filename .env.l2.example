# Production EVM/L2 deployment template. Copy to a private env file and replace
# every placeholder with addresses for the target network.
PRIVATE_KEY=
RPC_URL=https://your-l2-rpc.example
EXPECTED_CHAIN_ID=42161
PRODUCTION_DEPLOYMENT=true

# Native-token USD oracle on the target chain.
ETH_USD_FEED=0x0000000000000000000000000000000000000000
ETH_USD_MIN_ANSWER=50000000000
ETH_USD_MAX_ANSWER=1000000000000
PRICE_STALE_AFTER=3600

# One or more production payment tokens and target-chain USD feeds. The
# registry supports different symbols and decimal counts, including USDC/USDT.
PAYMENT_TOKENS=0x0000000000000000000000000000000000000000
PAYMENT_TOKEN_USD_FEEDS=0x0000000000000000000000000000000000000000
PAYMENT_TOKEN_MIN_ANSWERS=80000000
PAYMENT_TOKEN_MAX_ANSWERS=120000000

# Under $1,000: 15%. $1,000 and above: 10%.
DEFAULT_RESERVE_BPS=1000
RESERVE_BRACKET_MAX_USD=1000000000000000000000,115792089237316195423570985008687907853269984665640564039457584007913129639935
RESERVE_BRACKET_BPS=1500,1000
SECONDARY_FEE_BPS=200

# Use production multisigs or governed modules. Do not leave these as the
# deployer EOA on a live-value network.
PLATFORM_RECIPIENT=0x0000000000000000000000000000000000000000
VAULT_RESERVE_RECIPIENT=0x0000000000000000000000000000000000000000
INSURANCE_RESERVE_RECIPIENT=0x0000000000000000000000000000000000000000
TREASURY_RESERVE_RECIPIENT=0x0000000000000000000000000000000000000000
