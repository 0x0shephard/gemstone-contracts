# Copy this file to .env and keep .env private.
# Never commit or paste PRIVATE_KEY into chat.
PRIVATE_KEY=
EXPECTED_CHAIN_ID=11155111
PRODUCTION_DEPLOYMENT=false

# Ethereum Sepolia RPC endpoint.
SEPOLIA_RPC_URL=https://sepolia.example-rpc.invalid/YOUR_KEY

# Chainlink ETH / USD on Ethereum Sepolia (8 decimals).
ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
ETH_USD_MIN_ANSWER=50000000000
ETH_USD_MAX_ANSWER=1000000000000

# Maximum accepted oracle age. Confirm this testnet availability/security choice
# before broadcasting.
PRICE_STALE_AFTER=86400

# Digital Carat mUSDC and its test-only USD feed on Ethereum Sepolia.
# These have no monetary value and must never be reused on a production chain.
PAYMENT_TOKENS=0x29f4b1eF7261A372DB73493004CCf6A28175Dc54
PAYMENT_TOKEN_USD_FEEDS=0x3B2FD5faae46fcE73e4d7ef17c6100F1Dadb8b69
PAYMENT_TOKEN_MIN_ANSWERS=80000000
PAYMENT_TOKEN_MAX_ANSWERS=120000000

# Updated reserve policy. Values are 18-decimal USD and basis points.
DEFAULT_RESERVE_BPS=1000
RESERVE_BRACKET_MAX_USD=1000000000000000000000,115792089237316195423570985008687907853269984665640564039457584007913129639935
RESERVE_BRACKET_BPS=1500,1000

# Existing proxy configuration used by the in-place V2 upgrade scripts.
PAYMENT_TOKEN_REGISTRY_ADDRESS=0x7eF14F3994c10Fa773A02dD2509708C4375612bA
PAYMENT_TOKEN_BACKFILL=0x0000000000000000000000000000000000000000,0x29f4b1eF7261A372DB73493004CCf6A28175Dc54
RESERVE_MANAGER_ADDRESS=0x2143D4242ac10EEBB07bD59b3CAb16480e017c63

# Proposed 2% secondary-market fee.
SECONDARY_FEE_BPS=200

# Leave blank to use the deployer for a Sepolia-only deployment, or provide the
# intended Safe/role addresses before broadcasting.
# PLATFORM_RECIPIENT=0x...
# VAULT_RESERVE_RECIPIENT=0x...
# INSURANCE_RESERVE_RECIPIENT=0x...
# TREASURY_RESERVE_RECIPIENT=0x...
